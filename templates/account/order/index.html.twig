{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/account.css') }}"/>
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="row">

			<div class="col-lg-3">
				{% include 'account/_menu.html.twig' %}
			</div>

			<div class="col-lg-9">

				<div class="dd-account-header">
					<h1 class="dd-account-title">Ma Wishlist</h1>
				</div>

				{% if app.user.wishlists is empty %}
					<div class="dd-account-card">
						<div class="dd-empty-state">
							<i class="bi bi-heart"></i>
							<p>Aucun produit dans votre liste de souhaits.</p>
						</div>
					</div>
				{% else %}
					<div class="products-grid">
						{% for product in app.user.wishlists %}
						 {% include 'partials/_product_card.html.twig' %} with {
								product: product,
								isInWishlist: true
							} %}
						{% endfor %}
					</div>
				{% endif %}

			</div>

		</div>
	</div>
{% endblock %}