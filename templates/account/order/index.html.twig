{% extends 'base.html.twig' %}

{% block body %}
	<div class="container my-5">

		<div class="col-lg-3">
			{% include 'account/_menu.html.twig' %}
		</div>

		<h1>Mes commandes</h1>

		{% if orders is empty %}
			<p>Vous n'avez pas encore passé de commande.</p>
		{% else %}
			<table class="table">
				<thead>
					<tr>
						<th>N°</th>
						<th>Date</th>
						<th>Transporteur</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for order in orders %}
						<tr>
							<td>{{ order.id }}</td>
							<td>{{ order.createdAt|date('d/m/Y') }}</td>
							<td>{{ order.carrierName }}</td>
							<td>
								<a href="{{ path('app_account_order_show', {id_order: order.id}) }}" class="btn btn-sm btn-primary">
									Voir le détail
								</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% endif %}
	</div>
{% endblock %}
