{% extends 'base.html.twig' %}

{% block body %}
    {% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/account.css') }}"/>
{% endblock %}

<div class="container py-5">

    <div class="dd-account-header">
        <p class="section-eyebrow">Espace membre</p>
        <h1 class="dd-account-title">Sécurité</h1>
        <div class="gold-rule"></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            {% include 'account/_menu.html.twig' %}
        </div>

        <div class="col-lg-9">
            <div class="dd-account-card">
                <h5>Modification de mon mot de passe</h5>
                {{ form(modifyPwd) }}
            </div>
        </div>
    </div>

</div>
{% endblock %}
