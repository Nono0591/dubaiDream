<div class="account-menu">

    <a href="{{ path('app_account') }}"
       class="{{ app.request.attributes.get('_route') == 'app_account' ? 'active' : '' }}">
        <i class="bi bi-box-seam"></i>
        <span>Mes commandes</span>
    </a>

    <a href="{{ path('app_account_addresses') }}"
       class="{{ app.request.attributes.get('_route') == 'app_account_addresses' ? 'active' : '' }}">
        <i class="bi bi-geo-alt"></i>
        <span>Mes adresses</span>
    </a>

    <a href="{{ path('app_account_wishlist') }}"
       class="{{ app.request.attributes.get('_route') == 'app_account_wishlist' ? 'active' : '' }}">
        <i class="bi bi-heart"></i>
        <span>Ma liste de souhaits</span>
    </a>

    <a href="{{ path('app_account_modify_password') }}"
       class="{{ app.request.attributes.get('_route') == 'app_account_modify_password' ? 'active' : '' }}">
        <i class="bi bi-lock"></i>
        <span>Modifier mon mot de passe</span>
    </a>

    {% if is_granted('ROLE_ADMIN') %}
        {# ⚠️ Vérifie le nom exact de cette route (bin/console debug:router),
           "admin" seul n'existe probablement pas — souvent un préfixe type
           "easyadmin" ou "admin_dashboard". #}
        <a href="{{ path('admin') }}">
            <i class="bi bi-speedometer2"></i>
            <span>Administration</span>
        </a>
    {% endif %}

    <hr class="my-2">

    <a href="{{ path('app_logout') }}" class="text-danger">
        <i class="bi bi-box-arrow-right"></i>
        <span>Me déconnecter</span>
    </a>

</div>
