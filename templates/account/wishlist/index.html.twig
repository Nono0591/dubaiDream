{% extends 'base.html.twig' %}

{% block title %}Ma wishlist{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="dd-account-header">
        <h1 class="dd-account-title">Ma wishlist</h1>
        <p class="text-muted mb-0">
            Retrouvez ici tous vos produits favoris.
        </p>
    </div>

    <div class="dd-account-layout">

        {% include 'account/_menu.html.twig' %}

        <div class="dd-account-main">

            {% if app.user.wishlists|length > 0 %}

                <div class="products-grid">
                    {% for product in app.user.wishlists %}
                        {% set isInWishlist = true %}
                        {% include 'partials/_product_card.html.twig' %}
                    {% endfor %}
                </div>

            {% else %}

                <div class="dd-account-card">
                    <div class="dd-empty-state">
                        <i class="bi bi-heart"></i>
                        <h4 class="mb-3">Votre wishlist est vide</h4>
                        <p>Ajoutez vos parfums et produits favoris afin de les retrouver facilement.</p>
                        <a href="{{ path('app_products') }}" class="btn-gold">
                            Découvrir nos produits
                        </a>
                    </div>
                </div>

            {% endif %}

        </div>

    </div>

</div>

{% endblock %}