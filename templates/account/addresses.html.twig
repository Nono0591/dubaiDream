{% extends 'base.html.twig' %}



{% block body %}
<div class="container my-5">

    <h1>Espace membre</h1>

<div class="row">
        <div class="col-md-3">
            {% include  'account/_menu.html.twig' %}  
        </div>
        <div class="col-md-9">
        <h5>Mes adresses</h5>
            <a href="{{ path ('app_account_address_form') }}" class='btn btn-ligth'> Ajouter une adresse</a>

        <div class="row">
             {% for address in app.user.addresses %}   
                <div class="col-md-3">
                    <div>
                        {{address.firstname}} {{address.lastname}}<br/>
                        {{address.adress}}<br/>
                        {{address.poscode}} {{address.city}}<br/>
                        {{address.country}}


                    </div>

                </div>

        </div>

    </div>
 </div>
        
</div>
{% endblock %}
