<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>{% block title %}Dubai Dream — L'Art du Luxe Oriental{% endblock %}</title>

	{# Bootstrap 5 #}
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>

	{# Bootstrap Icons — remonté dans le head pour être dispo dès le premier rendu (navbar, footer...) #}
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

	{# Google Fonts #}
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>

	<style>
	:root{
		--dd-gold: #b9852f;
		--dd-gold-dark: #9c6f26;
		--dd-gold-light: #d9ac5c;
		--dd-red: #e14b3f;
		--dd-cream: #fbf6ec;
		--dd-cream2: #f4ead4;
		--dd-cream3: #efe2c4;
		--dd-ink: #211a10;
		--dd-ink-soft: #3c3120;
		--dd-muted: #8a7c62;
		--dd-line: #ece2cb;
	}

	body{
		font-family: 'DM Sans', sans-serif;
		background-color: #fff;
		color: var(--dd-ink);
	}
	a{ text-decoration:none; }
	.font-display{ font-family:'Playfair Display', serif; }
	.text-dd-gold{ color: var(--dd-gold) !important; }
	.bg-dd-cream{ background: var(--dd-cream) !important; }

	.section-eyebrow{
		font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase;
		color: var(--dd-gold); margin-bottom: 0.75rem; font-weight:600;
	}
	.dd-section-title{ font-family:'Playfair Display', serif; font-weight:600; font-size:1.5rem; color:var(--dd-ink); }
	.dd-section-link{ font-size:13px; color:var(--dd-gold); font-weight:500; }
	.dd-section-link:hover{ color:var(--dd-gold-dark); }
	.gold-rule{ width: 2.5rem; height: 1px; background: var(--dd-gold); }

	/* ── Boutons partagés ── */
	.btn-gold{
		background: var(--dd-gold); color:#fff; border:none; border-radius:2px;
		letter-spacing:.04em; font-weight:600; font-size:.85rem; padding:.7rem 1.4rem;
		transition: background-color .2s;
	}
	.btn-gold:hover{ background: var(--dd-gold-dark); color:#fff; }
	.btn-outline-dark-dd{
		background:transparent; color:var(--dd-ink); border:1px solid var(--dd-ink); border-radius:2px;
		letter-spacing:.04em; font-weight:600; font-size:.85rem; padding:.7rem 1.4rem;
		transition: all .2s;
	}
	.btn-outline-dark-dd:hover{ background:var(--dd-ink); color:#fff; }
	.btn-add-dd{
		background: var(--dd-gold); color:#fff; border:none; border-radius:2px;
		font-size:.78rem; font-weight:600; letter-spacing:.02em; padding:.5rem .9rem;
		display:inline-flex; align-items:center; white-space:nowrap; transition: background-color .2s;
	}
	.btn-add-dd:hover{ background: var(--dd-gold-dark); color:#fff; }

	/* ============================================================
	   Top bar (bandeau au-dessus de la navbar)
	   ============================================================ */
	.dd-topbar{
		background: linear-gradient(90deg, var(--dd-gold-dark), var(--dd-gold), var(--dd-gold-dark));
		color:#fff; font-size:12px;
	}
	.dd-topbar a{ color:#fff; opacity:.92; }
	.dd-topbar a:hover{ opacity:1; text-decoration:underline; }

	/* ============================================================
	   Navbar (_navbar.html.twig)
	   ============================================================ */
	.dd-navbar{ background:#fff; border-bottom:1px solid var(--dd-line); }
	.dd-navbar .navbar-brand{ display:flex; align-items:center; gap:.6rem; }
	.dd-navbar .brand-mark{
		width:40px; height:40px; border:1.5px solid var(--dd-gold); border-radius:50%;
		display:flex; align-items:center; justify-content:center;
		font-family:'Playfair Display', serif; font-weight:700; color:var(--dd-gold); font-size:13px; flex-shrink:0;
	}
	.dd-navbar .brand-text{ line-height:1.05; }
	.dd-navbar .brand-text .top{ font-family:'Playfair Display', serif; font-weight:700; font-size:18px; letter-spacing:.05em; color:var(--dd-ink); display:block; }
	.dd-navbar .brand-text .bottom{ font-size:9px; letter-spacing:.3em; color:var(--dd-gold); text-transform:uppercase; display:block; }

	.dd-navbar .nav-link{
		font-size:13.5px; color:var(--dd-ink-soft) !important; padding:.5rem .9rem !important;
		transition:color .2s; position:relative;
	}
	.dd-navbar .nav-link:hover, .dd-navbar .nav-link.active{ color:var(--dd-gold) !important; }
	.dd-navbar .promo-badge{ background:var(--dd-red); color:#fff; font-size:9.5px; font-weight:700; border-radius:20px; padding:.1rem .4rem; margin-left:.35rem; }

	.dd-navbar .icon-btn{
		width:38px; height:38px; display:flex; align-items:center; justify-content:center;
		color:var(--dd-ink-soft); border:1px solid var(--dd-line); border-radius:50%; position:relative;
		background:#fff; transition:all .2s;
	}
	.dd-navbar .icon-btn:hover{ color:var(--dd-gold); border-color:var(--dd-gold); }
	.dd-navbar .icon-btn .cart-count{
		position:absolute; top:-6px; right:-6px; background:var(--dd-gold); color:#fff;
		font-size:10px; font-weight:700; min-width:17px; height:17px; border-radius:50%;
		display:flex; align-items:center; justify-content:center; padding:0 3px; border:2px solid #fff;
	}

	/* Sous-barre catégories facultative, injectée par la navbar */
	.dd-catnav{ background:var(--dd-cream); border-bottom:1px solid var(--dd-line); }
	.dd-catnav-btn{
		background:var(--dd-gold); color:#fff; border:none; font-size:13px; font-weight:500;
		padding:.55rem 1.1rem; display:flex; align-items:center; gap:.5rem; white-space:nowrap;
	}
	.dd-catnav-btn:hover{ background:var(--dd-gold-dark); color:#fff; }
	.dd-catnav-link{ font-size:13.5px; color:var(--dd-ink-soft); padding:.55rem .85rem; white-space:nowrap; transition:color .2s; }
	.dd-catnav-link:hover{ color:var(--dd-gold); }
	.dd-catnav-promo{ color:var(--dd-red) !important; font-weight:600; }
	.dd-catnav-promo .badge{ background:var(--dd-red); color:#fff; font-size:10px; margin-left:.35rem; }
	.dd-search input{
		border:1px solid var(--dd-line); border-right:none; background:var(--dd-cream); font-size:14px; padding:.6rem 1rem;
	}
	.dd-search input:focus{ box-shadow:none; border-color:var(--dd-gold); background:var(--dd-cream); }
	.dd-search button{ background:var(--dd-gold); border:1px solid var(--dd-gold); color:#fff; padding:0 1.1rem; }
	.dd-search button:hover{ background:var(--dd-gold-dark); }

	/* ============================================================
	   Carte produit (_product_card.html.twig)
	   ============================================================ */
	.dd-card{ background:#fff; border:1px solid var(--dd-line); display:flex; flex-direction:column; height:100%; transition:box-shadow .2s, border-color .2s; }
	.dd-card:hover{ border-color:var(--dd-gold); box-shadow:0 10px 28px rgba(185,133,47,.12); }
	.dd-card__img-wrap{ position:relative; aspect-ratio:1/1; background:var(--dd-cream); overflow:hidden; }
	.dd-card__img-wrap img{ width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
	.dd-card:hover .dd-card__img-wrap img{ transform:scale(1.05); }
	.dd-card__wishlist{
		position:absolute; top:10px; right:10px; width:30px; height:30px; border-radius:50%;
		background:#fff; border:1px solid var(--dd-line); display:flex; align-items:center; justify-content:center;
		color:var(--dd-ink-soft); font-size:14px; transition:all .2s;
	}
	.dd-card__wishlist:hover, .dd-card__wishlist.active{ color:var(--dd-red); border-color:var(--dd-red); }
	.dd-card__rank{
		position:absolute; top:10px; left:10px; width:26px; height:26px; border-radius:50%;
		background:var(--dd-gold); color:#fff; font-weight:700; font-size:13px;
		display:flex; align-items:center; justify-content:center;
	}
	.dd-card__body{ padding:1rem 1.1rem 1.1rem; display:flex; flex-direction:column; gap:.3rem; flex:1; }
	.dd-card__cat{ font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--dd-muted); }
	.dd-card__name{ font-size:14.5px; font-weight:600; color:var(--dd-ink); line-height:1.3; }
	.dd-card__rating{ font-size:11.5px; color:var(--dd-muted); }
	.dd-card__rating i{ color:var(--dd-gold); font-size:11px; }
	.dd-card__footer{ display:flex; align-items:center; justify-content:space-between; margin-top:auto; padding-top:.5rem; gap:.5rem; }
	.dd-card__price{ font-weight:700; font-size:15.5px; color:var(--dd-ink); }

	/* ============================================================
	   Panier offcanvas (_cart.html.twig)
	   ============================================================ */
	.dd-cart-offcanvas{ background:#fff; color:var(--dd-ink); max-width:400px; }
	.dd-cart-offcanvas .offcanvas-header{ border-bottom:1px solid var(--dd-line); }
	.dd-cart-offcanvas .offcanvas-title{ font-family:'Playfair Display', serif; font-weight:600; letter-spacing:.04em; font-size:1.05rem; }
	.dd-cart-line img{ width:60px; height:72px; object-fit:cover; flex-shrink:0; border:1px solid var(--dd-line); }
	.dd-cart-line .name{ font-family:'Playfair Display', serif; font-size:14px; font-weight:600; color:var(--dd-ink); line-height:1.25; }
	.dd-cart-line .sub{ font-size:11.5px; color:var(--dd-muted); margin-bottom:.35rem; }
	.dd-cart-line .price{ font-weight:600; color:var(--dd-gold); font-size:13.5px; }
	.dd-qty-btn{
		width:24px; height:24px; display:flex; align-items:center; justify-content:center;
		border:1px solid var(--dd-line); background:transparent; color:var(--dd-ink-soft); border-radius:2px; font-weight:600;
	}
	.dd-qty-btn:hover{ color:var(--dd-gold); border-color:var(--dd-gold); }
	.dd-cart-summary{ padding:1.25rem 1.5rem 1.5rem; border-top:1px solid var(--dd-line); }
	.dd-cart-summary .row-line{ display:flex; justify-content:space-between; font-size:13.5px; color:var(--dd-muted); margin-bottom:.5rem; }
	.dd-cart-summary .row-total{ display:flex; justify-content:space-between; font-weight:700; font-size:1.1rem; color:var(--dd-ink); margin:.75rem 0 1.1rem; padding-top:.75rem; border-top:1px solid var(--dd-line); }
	.dd-cart-shipnote{ font-size:11.5px; color:var(--dd-muted); text-align:center; margin:.75rem 0 0; }

	/* ============================================================
	   Footer (_footer.html.twig)
	   ============================================================ */
	.dd-footer{ background: var(--dd-ink); color:#cabf9e; }
	.dd-footer .brand-mark{
		width:38px; height:38px; border:1.5px solid var(--dd-gold-light); border-radius:50%;
		display:flex; align-items:center; justify-content:center;
		font-family:'Playfair Display', serif; font-weight:700; color:var(--dd-gold-light); font-size:12.5px;
	}
	.dd-footer__brand{ font-family:'Playfair Display', serif; font-weight:700; font-size:1.25rem; color:#fff; }
	.dd-footer__tagline{ font-size:12.5px; color:#948660; line-height:1.6; }
	.dd-footer__heading{ font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:#fff; font-weight:600; margin-bottom:1.1rem; }
	.dd-footer__link{ color:#a89972; font-size:13px; display:block; margin-bottom:.55rem; transition:color .2s; }
	.dd-footer__link:hover{ color:var(--dd-gold-light); }
	.dd-footer__bottom{ color:#71643f; font-size:11.5px; }
	.dd-footer__bottom a{ color:#71643f; }
	.dd-footer__bottom a:hover{ color:var(--dd-gold-light); }
	hr.dd-footer__bottom{ border-color: rgba(255,255,255,.08); }
	.dd-footer__social{ color:#a89972; font-size:17px; transition:color .2s; }
	.dd-footer__social:hover{ color: var(--dd-gold-light); }
	.dd-footer__nl-input{ background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); color:#fff; font-size:13.5px; padding:.6rem .9rem; border-radius:2px 0 0 2px; }
	.dd-footer__nl-input::placeholder{ color:#8a7c62; }
	.dd-footer__nl-input:focus{ outline:none; border-color:var(--dd-gold); background:rgba(255,255,255,.08); }
	.dd-footer__nl-btn{ background:var(--dd-gold); border:1px solid var(--dd-gold); color:#fff; padding:0 1.1rem; border-radius:0 2px 2px 0; }
	.dd-footer__nl-btn:hover{ background:var(--dd-gold-dark); }

	/* ── Misc ── */
	::-webkit-scrollbar{ width:0; }
	</style>

	{% block stylesheets %}{% endblock %}
</head>
<body>

{% block navbar %}
<div id="ddHeaderStack">
	{% include 'partials/_navbar.html.twig' %}
</div>
{% endblock %}

{% block cart_offcanvas %}
	{% include 'partials/_cart.html.twig' %}
{% endblock %}

{% block body %}{% endblock %}

{% block footer %}
	{% include 'partials/_footer.html.twig' %}
{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
	// Mesure la hauteur réelle de la topbar + navbar + sous-barre catégories
	// pour que le hero + la trust-bar occupent exactement l'espace restant
	// jusqu'à 100vh (voir .dd-fold dans index.html.twig).
	function ddSetHeaderHeight(){
		var el = document.getElementById('ddHeaderStack');
		if (el) {
			document.documentElement.style.setProperty('--dd-header-h', el.offsetHeight + 'px');
		}
	}
	document.addEventListener('DOMContentLoaded', ddSetHeaderHeight);
	window.addEventListener('load', ddSetHeaderHeight);
	window.addEventListener('resize', ddSetHeaderHeight);
</script>

{% block javascripts %}{% endblock %}
</body>
</html>