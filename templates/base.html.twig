<!DOCTYPE html>
<html lang="fr">
	<head>
    <script>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>
			{% block title %}Dubai Dream 59
			{% endblock %}
		</title>

		{# Bootstrap 5 #}
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>

		{# Bootstrap Icons — remonté dans le head pour être dispo dès le premier rendu (navbar, footer...) #}
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

		{# Google Fonts #}
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link
		href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>

		{# Styles maison, découpés par composant. Ordre = ordre de cascade.
			   Fichiers physiquement dans assets/styles/ (AssetMapper). #}
		<link rel="stylesheet" href="{{ asset('styles/base.css') }}"/>
		<link rel="stylesheet" href="{{ asset('styles/navbar.css') }}"/>
		<link rel="stylesheet" href="{{ asset('styles/footer.css') }}"/>
		<link
		rel="stylesheet" href="{{ asset('styles/product.css') }}"/>

		{# CSS propre à chaque page (home.css, account.css...) vient APRES,
			   donc peut surcharger base/navbar/footer/product si besoin. #}
		{% block stylesheets %}{% endblock %}
	</head>
	<body>

		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label }} alert-dismissible fade show m-0 rounded-0 text-center" role="alert">
					{{ message }}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			{% endfor %}
		{% endfor %}

		{% block navbar %}
			<div id="ddHeaderStack">
				{% include 'partials/_navbar.html.twig' %}
			</div>
		{% endblock %}

		{% block cart_offcanvas %}
			{% include 'partials/_cart.html.twig' %}
		{% endblock %}

		{% block body %}{% endblock %}

		{% block footer %}
			{% include 'partials/_footer.html.twig' %}
		{% endblock %}

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

		<script>
			// Mesure la hauteur réelle de la topbar + navbar + sous-barre catégories
// pour que le hero + la trust-bar occupent exactement l'espace restant
// jusqu'à 100vh (voir .dd-fold dans home.css).
function ddSetHeaderHeight() {
var el = document.getElementById('ddHeaderStack');
if (el) {
document.documentElement.style.setProperty('--dd-header-h', el.offsetHeight + 'px');
}
}
document.addEventListener('DOMContentLoaded', ddSetHeaderHeight);
window.addEventListener('load', ddSetHeaderHeight);
window.addEventListener('resize', ddSetHeaderHeight);
		</script>

		{% block javascripts %}
		   {{ importmap('app') }}
		{% endblock %}
	</body>
</html>