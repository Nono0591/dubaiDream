{% extends 'base.html.twig' %}

{% block body %}

	<div class="container mt-5">
		<h1>{{ category.name }}</h1>

		<p>Cette catégorie contient
			{{ category.products|length }}
			produit(s).</p>

		<div class="products-grid">
			{% for product in category.products %}
				<div class="product-item">
					<a href="{{ path('app_product',{slug:product.slug}) }}" class="text-decoration-none text-dark">
						<img src="/uploads/{{ product.illustration }}" alt="{{ product.name }}" class="img-fluid">
						<span class="d-block fw-bold">{{ product.name }}</span>
					</a>

					<span class="d-block">{{ product.priceWT|price }}</span>
				</div>
			{% endfor %}
		</div>
	</div>

{% endblock %}
