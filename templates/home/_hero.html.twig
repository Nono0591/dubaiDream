{# ==================== Fold : hero + trust-bar ==================== #}
<div class="dd-fold">

	{# ==================== Hero Carousel ==================== #}
	<section class="dd-hero" aria-label="Bannière principale">
		<div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">

			{% if headers is defined and headers|length > 1 %}
				<div class="carousel-indicators">
					{% for key, header in headers %}
						<button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="{{ key }}" {% if key == 0 %} class="active" aria-current="true" {% endif %} aria-label="Diapositive : {{ header.title|default('En-tête ' ~ loop.index) }}"></button>
					{% endfor %}
				</div>
			{% endif %}

			<div class="carousel-inner">
				{% if headers is defined and headers|length > 0 %}
					{% for key, header in headers %}
						<div class="carousel-item {% if key == 0 %}active{% endif %}">
							<div class="dd-hero-zoom">
								{% if header.illustration is defined and header.illustration %}
									<img src="{{ asset('uploads/' ~ header.illustration) }}" alt="{{ header.title|default('Dubai Dream Promo') }}" class="dd-hero-img">
								{% else %}
									<img src="{{ asset('images/default-hero.jpg') }}" alt="Dubai Dream - Luxe Oriental" class="dd-hero-img">
								{% endif %}
							</div>
							<div class="dd-hero-overlay"></div>

							<div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center">
								<div class="container-xl px-4 px-md-5">
									<div class="row align-items-center">
										<div class="col-xl-6 col-lg-7">
											<div class="dd-hero-badge dd-hero-eyebrow mb-3">
												<i class="bi bi-stars me-2" aria-hidden="true"></i>
												Plus de 3 000 produits • Parfums • Maison • Hygiène
											</div>
											{% if header.title is defined %}
												<h1 class="dd-hero-title mb-3">{{ header.title }}</h1>
											{% endif %}
											{% if header.content is defined %}
												<p class="dd-hero-lede mb-4">{{ header.content }}</p>
											{% endif %}
											{% if header.buttonLink and header.buttonTitle %}
												<a href="{{ header.buttonLink }}" class="btn btn-gold btn-lg px-4 py-2">
													{{ header.buttonTitle }}
												</a>
											{% endif %}
										</div>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				{% endif %}
			</div>

			{% if headers is defined and headers|length > 1 %}
				<button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Précédent">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Suivant">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
				</button>
			{% endif %}

		</div>
	</section>

	{# ==================== Trust Bar ==================== #}
	<div class="dd-trust bg-light border-bottom">
		<div class="container-xl px-4 px-md-5 py-4">
			<div class="row g-4">
				{% for t in [
                    { icon: 'bi-truck', title: 'Livraison rapide', sub: '24/48h chez vous' },
                    { icon: 'bi-shield-lock', title: 'Paiement sécurisé', sub: 'CB, PayPal, 3x sans frais' },
                    { icon: 'bi-award', title: 'Produits authentiques', sub: 'Sélection premium' },
                    { icon: 'bi-arrow-repeat', title: 'Satisfait ou remboursé', sub: '14 jours pour changer d\'avis' }
                ] %}
                    <div class="col-6 col-md-3">
                        <div class="dd-trust-item d-flex align-items-center gap-3">
                            <i class="bi {{ t.icon }} fs-3 text-dd-gold" aria-hidden="true"></i>
                            <div>
                                <div class="fw-bold text-dark small">{{ t.title }}</div>
                                <div class="text-muted small fs-7">{{ t.sub }}</div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

</div>