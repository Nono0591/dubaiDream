{# ==================== Marques ==================== #}

<section class="py-5 bg-white" aria-label="Nos marques partenaires">
    <div class="container-xl px-4 px-md-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <h2 class="dd-section-title mb-0">
                Les plus grandes marques, réunies pour vous
            </h2>

            <a href="{{ path('app_brands') }}" class="dd-section-link text-decoration-none">
                Voir toutes les marques
                <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        {% if brands is defined and brands|length > 0 %}
            <div class="dd-brands-wrapper overflow-hidden">
                <div class="dd-brands-track d-flex gap-4">

                    {# Bandeau principal #}
                    <div class="dd-brands-strip d-flex align-items-center gap-4">
                        {% for brand in brands %}
                            <div class="dd-brand-logo p-2">
                                <img
                                    src="{{ asset('uploads/icone/' ~ brand.logo) }}"
                                    alt="Marque {{ brand.name }}"
                                    loading="lazy"
                                    height="40"
                                >
                            </div>
                        {% endfor %}
                    </div>

                    {# Duplication technique pour défilement infini (masquée pour l'accessibilité) #}
                    <div class="dd-brands-strip d-flex align-items-center gap-4" aria-hidden="true">
                        {% for brand in brands %}
                            <div class="dd-brand-logo p-2">
                                <img
                                    src="{{ asset('uploads/icone/' ~ brand.logo) }}"
                                    alt=""
                                    loading="lazy"
                                    height="40"
                                >
                            </div>
                        {% endfor %}
                    </div>

                </div>
            </div>
        {% endif %}
    </div>
</section>