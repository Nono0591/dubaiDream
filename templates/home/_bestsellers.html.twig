{# ==================== Top ventes ==================== #}

<section class="py-5 bg-white" id="best-sellers">

    <div class="container-xl px-4 px-md-5">

        <div class="row align-items-end mb-5">

            <div class="col-lg-8">

                <span class="section-eyebrow">
                    Les favoris de nos clients
                </span>

                <h2 class="dd-section-title mb-2">
                    Les meilleures ventes
                </h2>

                <p class="text-muted mb-0">
                    Les produits les plus commandés cette semaine. Une sélection appréciée pour leur qualité et leur excellent rapport qualité-prix.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                <a href="{{ path('app_products') }}" class="btn-outline-dark-dd">
                    Voir tous les produits
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>

            </div>

        </div>

        <div class="row g-4 row-cols-2 row-cols-md-3 row-cols-lg-5">

            {% for product in products|slice(0,5) %}

                <div class="col">

                    {% include 'partials/_product_card.html.twig' with {
                        product: product,
                        rank: loop.index,
                        bestseller: true
                    } only %}

                </div>

            {% endfor %}

        </div>

    </div>

</section>