{# ==================== Pourquoi nous ==================== #}
<section class="py-4 dd-why-banner">
	<div class="container-xl px-4 px-md-5">
		<div class="row align-items-center g-4">

			<div class="col-lg-4">
				<h2 class="dd-section-title mb-2">Pourquoi choisir<br>Dubai Dream ?</h2>
				<p class="text-muted mb-3">Votre satisfaction est notre priorité au quotidien.</p>
				<a href="{{ path('app_about') }}" class="btn btn-gold btn-sm px-3">En savoir plus</a>
			</div>

			<div class="col-lg-8">
				<div class="row g-0 dd-why-stats">
					<div class="col-6 col-md-3 dd-why-stat">
						<i class="bi bi-patch-check"></i>
						<div class="num">+15 000</div>
						<div class="label">Clients satisfaits</div>
					</div>
					<div class="col-6 col-md-3 dd-why-stat">
						<i class="bi bi-box-seam"></i>
						<div class="num">+3 000</div>
						<div class="label">Produits disponibles</div>
					</div>
					<div class="col-6 col-md-3 dd-why-stat">
						<i class="bi bi-truck"></i>
						<div class="num">24/48h</div>
						<div class="label">Livraison rapide</div>
					</div>
					<div class="col-6 col-md-3 dd-why-stat">
						<i class="bi bi-star"></i>
						<div class="num">98%</div>
						<div class="label">Avis positifs</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>

{# ==================== Avis clients & Réseaux sociaux ==================== #}
<section class="py-5 bg-white">
	<div class="container-xl px-4 px-md-5">
		<div
			class="row g-5 align-items-start">

			{# ==================== Avis clients ==================== #}
			<div class="col-lg-7">

				<div class="d-flex justify-content-between align-items-center mb-4">
					<div>
						<span class="section-eyebrow">Avis clients</span>
						<h2 class="dd-section-title mb-1">Ils parlent de nous</h2>
					</div>

					<a href="https://www.google.com/search?sa=X&sca_esv=9b617dd2a71044a6&sxsrf=APpeQnsPx1dQShVJF1v4IWGuFVUoDdtZYQ:1787516997624&q=DUBAI+DREAM+Avis&rflfq=1&num=20&stick=H4sIAAAAAAAAAONgkxI2tjA2NTU3MDIysDC0NDYyMDMz3sDI-IpRwCXUydFTwSXI1dFXwbEss3gRK4YQAKrQWz5AAAAA&rldimm=3835570220819320663&tbm=lcl&hl=fr-CA&ved=2ahUKEwiwkbHdy7eWAxWWNoYAHRaxK0sQ9fQKegQIRxAC&biw=1920&bih=945&dpr=1#lkt=LocalPoiReviews" class="dd-section-link" target="_blank" rel="noopener">
						Voir tous les avis
						<i class="bi bi-arrow-right ms-1"></i>
					</a>
				</div>

				<div class="row g-4">
					{% for r in reviews|slice(0,3) %}
						<div class="col-md-4">
							<div class="dd-review-card h-100">
								<div class="d-flex align-items-center mb-3">
									<div class="dd-review-avatar">{{ r.avatar }}</div>
									<div class="ms-3">
										<strong class="dd-review-name d-block">{{ r.name }}</strong>
										<small class="dd-review-meta">{{ r.date }}</small>
									</div>
								</div>

								<div class="mb-3">
									{% for i in 1..5 %}
										<i class="bi bi-star-fill" style="color:{{ i <= r.rating ? 'var(--dd-gold)' : '#ddd' }}"></i>
									{% endfor %}
								</div>

								<p class="dd-review-text mb-0">«
									{{ r.text }}
									»</p>
							</div>
						</div>
					{% endfor %}
				</div>

				{% if reviews|length > 3 %}
					<div class="dd-review-dots mt-4">
						{% for r in reviews|slice(0,3) %}
							<span class="dot {{ loop.first ? 'active' : '' }}"></span>
						{% endfor %}
					</div>
				{% endif %}

			</div>

			{# ==================== tiktok ==================== #}
			<div class="col-lg-5">

				<div class="d-flex justify-content-between align-items-center mb-4">
					<div>
						<span class="section-eyebrow">Réseaux sociaux</span>
						<h2 class="dd-section-title mb-1">Suivez-nous sur TikTok</h2>
						<p class="text-muted mb-0">@dubaidream59</p>
					</div>

					<a href="https://www.tiktok.com/@dubaidream59" target="_blank" class="dd-pill-link">
						Voir tout
					</a>
				</div>

				{% set tiktokVideos = [
                    'https://www.tiktok.com/@dubaidream59/video/7567065197475597590?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909',
                    'https://www.tiktok.com/@dubaidream59/video/7490912609487703318?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909',
                    'https://www.tiktok.com/@dubaidream59/video/7494961943472803074?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909',
                    'https://www.tiktok.com/@dubaidream59/video/7567065197475597590?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909',
                    'https://www.tiktok.com/@dubaidream59/video/7490912609487703318?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909',
                    'https://www.tiktok.com/@dubaidream59/video/7494961943472803074?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909',
                    'https://www.tiktok.com/@dubaidream59/video/7567065197475597590?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909',
                    'https://www.tiktok.com/@dubaidream59/video/7490912609487703318?is_from_webapp=1&sender_device=pc&web_id=7677227340421776909'
                ] %}

				<div class="row g-3" id="tiktok-grid">
					{% for videoUrl in tiktokVideos %}
						<div class="col-3">
							<div class="dd-social-card" data-video-url="{{ videoUrl }}">
								<img src="{{ asset('uploads/tiktok/tiktok-' ~ loop.index ~ '.jpg') }}" alt="TikTok {{ loop.index }}" loading="lazy">
							</div>
						</div>
					{% endfor %}
				</div>

			</div>

		</div>
	</div>
</section>
