{# ==================== Produits populaires ==================== #}

<section class="py-5 bg-dd-cream" id="selection">

    <div class="container-xl px-4 px-md-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">

            <div>

                <span class="section-eyebrow">
                    Nos incontournables
                </span>

                <h2 class="dd-section-title mb-2">
                    Les produits préférés de nos clients
                </h2>

                <p class="text-muted mb-0">
                    Découvrez une sélection des meilleures ventes parmi nos parfums, produits maison et soins du quotidien.
                </p>

            </div>

            <a href="{{ path('app_products') }}" class="btn-outline-dark-dd">
                Voir tous les produits
                <i class="bi bi-arrow-right ms-2"></i>
            </a>

        </div>

        <div class="row g-4 row-cols-2 row-cols-md-3 row-cols-lg-5">

            {% for product in products|slice(0,10) %}

                <div class="col">

                    {% include 'partials/_product_card.html.twig' with {
                        product: product
                    } only %}

                </div>

            {% endfor %}

        </div>

    </div>

</section>