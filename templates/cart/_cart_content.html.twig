<div id="cart-data" data-quantity="{{ fullCartQuantity }}"></div>

{% if cart|length > 0 %}

<div class="flex-grow-1">

    {% for product in cart %}

    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">

        <img
            src="{{ asset('uploads/products/' ~ product.object.illustration) }}"
            alt="{{ product.object.name }}"
            class="rounded"
            style="width:70px;height:70px;object-fit:cover;"
        >

        <div class="ms-3 flex-grow-1">

            <div class="fw-bold">
                {{ product.object.name }}
            </div>

            <div class="small text-muted">
                {{ product.object.pricewt|price }} €
            </div>

            <div class="mt-2 d-flex align-items-center">

                <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary cart-update"
                    data-url="{{ path('app_cart_offcanvas_update', {
                        action:'decrease',
                        id:product.object.id
                    }) }}"
                >
                    <i class="bi bi-dash"></i>
                </button>

                <span class="mx-3 fw-bold">
                    {{ product.quantity }}
                </span>

                <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary cart-update"
                    data-url="{{ path('app_cart_offcanvas_update', {
                        action:'increase',
                        id:product.object.id
                    }) }}"
                >
                    <i class="bi bi-plus"></i>
                </button>

            </div>

        </div>

        <div class="text-end">

            <div class="fw-bold">
                {{ (product.quantity * product.object.pricewt)|price }} €
            </div>

            <button
                type="button"
                class="btn btn-link text-danger small text-decoration-none p-0 cart-update"
                data-url="{{ path('app_cart_offcanvas_update', {
                    action:'delete',
                    id:product.object.id
                }) }}"
            >
                Supprimer
            </button>

        </div>

    </div>

    {% endfor %}

</div>


<div class="border-top pt-3">

    {% if isShippingFree %}

        <div class="alert alert-success py-2 mb-3">
            🚚 Livraison offerte !
        </div>

    {% else %}

        <div class="alert alert-warning py-2 mb-3">
            Plus que
            <strong>{{ amountLeftForFreeShipping|price }} €</strong>
            pour profiter de la livraison offerte.
        </div>

    {% endif %}


    <div class="d-flex justify-content-between mb-2">

        <span>Total produits</span>

        <strong>{{ fullCartQuantity }}</strong>

    </div>


    <div class="d-flex justify-content-between mb-3">

        <span>Total TTC</span>

        <strong>{{ totalWt|price }} €</strong>

    </div>


    <div class="d-grid gap-2">

        <a href="{{ path('app_cart') }}"
           class="btn btn-outline-dark">

            Voir le panier

        </a>


        <a href="{{ path('app_order') }}"
           class="btn btn-dark">

            Commander

        </a>

    </div>

</div>

{% else %}

<div id="cart-data" data-quantity="0"></div>

<div class="text-center my-auto">

    <i class="bi bi-bag-x display-3 text-muted"></i>

    <h5 class="mt-3">
        Votre panier est vide
    </h5>

    <p class="text-muted">
        Découvrez nos produits et ajoutez vos coups de cœur.
    </p>

    <a href="{{ path('app_home') }}"
       class="btn btn-dark mt-2"
       data-bs-dismiss="offcanvas">

        Continuer mes achats

    </a>

</div>

{% endif %}