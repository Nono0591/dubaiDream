{% extends 'base.html.twig' %}

{% block title %}Contact — Dubai Dream{% endblock %}

{% block body %}

<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold">Contactez-nous</h1>
            <p class="text-muted">
                Une question sur une commande, un produit ou une livraison ?
                Notre équipe est à votre écoute et vous répondra dans les meilleurs délais.
            </p>
        </div>

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card border-0 shadow rounded-4">

                    <div class="card-body p-4 p-lg-5">

                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}

                        {{ form_start(form) }}

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                {{ form_row(form.lastname) }}
                            </div>

                            <div class="col-md-6 mb-3">
                                {{ form_row(form.firstname) }}
                            </div>

                        </div>

                        <div class="mb-3">
                            {{ form_row(form.email) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(form.subject) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(form.message) }}
                        </div>

                        <div class="text-end">

                            <button type="submit" class="btn btn-dark px-4">

                                <i class="bi bi-send me-2"></i>

                                Envoyer le message

                            </button>

                        </div>

                        {{ form_end(form) }}

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

{% endblock %}