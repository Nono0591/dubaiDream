{% extends 'base.html.twig' %}

{% block title %}Connexion | Dubai Dream{% endblock %}

{% block body %}

<section class="login-page py-5">
    <div class="container">

        <div class="row justify-content-center align-items-center">

            <div class="col-lg-5 col-md-8">

                <div class="login-card">

                    <div class="text-center mb-4">

                        <h1 class="login-title">
                            <i class="bi bi-person-circle me-2"></i>
                            Connexion
                        </h1>

                        <p class="login-subtitle">
                            Connectez-vous à votre espace membre pour suivre vos commandes,
                            gérer votre liste d'envies et retrouver tous vos achats.
                        </p>

                    </div>

                    {% if error %}
                        <div class="alert alert-danger rounded-3">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form action="{{ path('app_login') }}" method="post">

                        <div class="mb-3">

                            <label class="form-label">
                                Adresse e-mail
                            </label>

                            <input
                                class="form-control"
                                type="email"
                                id="username"
                                name="_username"
                                value="{{ lastUsername }}"
                                autocomplete="email"
                                required>

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Mot de passe
                            </label>

                            <input
                                class="form-control"
                                type="password"
                                id="password"
                                name="_password"
                                autocomplete="current-password"
                                required>

                        </div>

                        <input
                            type="hidden"
                            name="_target_path"
                            value="{{ path('app_account') }}"
                        >

                        <button class="btn btn-gold login-btn" type="submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Se connecter
                        </button>

                    </form>

                    <div class="login-links">

                        <a href="{{ path('app_password') }}">
                            Mot de passe oublié ?
                        </a>

                        <div class="divider">
                            <span>ou</span>
                        </div>
                        <p> Vous n'avez pas encore de compte ?</p>
                        <a class="btn btn-outline-dark register-btn"
                           href="{{ path('app_inscription') }}">
                            Créer un compte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}