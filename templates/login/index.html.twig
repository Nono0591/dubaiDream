{% extends 'base.html.twig' %}

{% block body %}

<div class="container mt-5">

    <h1>Connexion</h1>

    {% if error %}
        <div class="alert alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post">

        <label for="username">Votre email :</label>
        <input
            class="form-control"
            type="text"
            id="username"
            name="_username"
            value="{{ lastUsername }}"
            required
        >

        <label for="password" class="mt-3">Votre mot de passe :</label>
        <input class="form-control" type="password" id="password" name="_password" required
        >

        <input
            type="hidden"
            name="_target_path"
            value="{{ path('app_account') }}"
        >

        <button class="btn btn-success mt-3" type="submit">
            Me connecter
        </button>

    </form>

    <br>

    <a href="{{ path('app_inscription') }}">M'inscrire !</a><br>
    <a href="{{ path('app_password') }}">Mot de passe oublié ?</a>

</div>

{% endblock %}