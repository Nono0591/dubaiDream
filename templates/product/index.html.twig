{% extends 'base.html.twig' %}

{% block body %}

    <div class="container mt-5">
        <div class="row">

            <div class="col-md-6">
                <img src="{{ asset('uploads/products/' ~ product.illustration) }}" alt="{{ product.name }}" class="img-fluid">
            </div>

            <div class="col-md-6">

                <small>
                    <i>
                        <a href="{{ path('app_category', {'slug': product.category.slug}) }}">
                            {{ product.category.name }}
                        </a>
                        >
                        {{ product.name }}
                    </i>
                </small>

                <h1>{{ product.name }}</h1>

                <p>{{ product.description|raw }}</p>

                <h3>{{ product.priceWt | price }}</h3>

                <div class="d-flex align-items-center mt-3">

                    <a href="{{ path('app_cart_add', { id : product.id }) }}" class="btn btn-success">
                        Ajouter au panier
                    </a>

                    {% if app.user %}

                        {% if product in app.user.wishlists %}
                            <a class="wishlist-icon wishlist-icon-active" href="{{ path('app_account_wishlist_remove', { id : product.id }) }}" style="margin-left: 15px; font-size: 1.8rem;">
                                <i class="bi bi-heart-fill"></i>
                            </a>
                        {% else %}
                            <a class="wishlist-icon" href="{{ path('app_account_wishlist_add', { id : product.id }) }}" style="margin-left: 15px; font-size: 1.8rem;">
                                <i class="bi bi-heart"></i>
                            </a>
                        {% endif %}

                    {% else %}

                        <a data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample" style="margin-left: 15px; font-size: 1.8rem;">
                            <i class="bi bi-heart"></i>
                        </a>

                    {% endif %}

                </div>

                <div class="collapse mt-3" id="collapseExample">
                    <div>
                        Pour utiliser les avantages de la wishlist,
                        <a href="{{ path('app_login') }}">connectez-vous</a>
                        ou
                        <a href="{{ path('app_inscription') }}">créez un compte</a>
                    </div>
                </div>

            </div>

        </div>
    </div>

{% endblock %}