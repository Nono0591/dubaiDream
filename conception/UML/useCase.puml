@startuml
left to right direction

actor Administrateur
actor Client
actor "Système de paiement" as Paiement

rectangle "Site e-commerce" {

  ' --- Back-office (Administrateur) ---
  usecase "Gérer les actualités" as UC_Actu
  usecase "Ajouter une actualité" as UC_Actu_Add
  usecase "Modifier une actualité" as UC_Actu_Mod

  usecase "Gérer les produits" as UC_Prod
  usecase "Ajouter un produit" as UC_Prod_Add
  usecase "Modifier un produit" as UC_Prod_Mod
  usecase "Supprimer un produit" as UC_Prod_Del

  usecase "Gérer le stock" as UC_Stock
  usecase "Mettre à jour le stock" as UC_Stock_Update
  usecase "Alerter stock faible" as UC_Stock_Alert

  usecase "Gérer les commandes" as UC_Cmd_Admin
  usecase "Consulter les commandes" as UC_Cmd_View
  usecase "Valider une commande" as UC_Cmd_Validate
  usecase "Expédier une commande" as UC_Cmd_Ship

  usecase "Gérer les utilisateurs" as UC_User_Admin
  usecase "Consulter les utilisateurs" as UC_User_View
  usecase "Bloquer un utilisateur" as UC_User_Block

  ' --- Front-office (Client) ---
  usecase "S'inscrire / se connecter" as UC_Auth
  usecase "Créer un compte" as UC_Auth_Register
  usecase "Se connecter" as UC_Auth_Login

  usecase "Consulter les produits" as UC_Browse
  usecase "Voir les détails du produit" as UC_Browse_Detail

  usecase "Gérer le panier" as UC_Cart
  usecase "Ajouter au panier" as UC_Cart_Add

  usecase "Passer une commande" as UC_Order
  usecase "Payer la commande" as UC_Pay
  usecase "Saisir les coordonnées de paiement" as UC_Pay_Input

  usecase "Suivre ses commandes" as UC_Track
}

' --- Relations Administrateur ---
Administrateur --> UC_Actu
UC_Actu ..> UC_Actu_Add : <<include>>
UC_Actu ..> UC_Actu_Mod : <<include>>

Administrateur --> UC_Prod
UC_Prod ..> UC_Prod_Add : <<include>>
UC_Prod ..> UC_Prod_Mod : <<include>>
UC_Prod ..> UC_Prod_Del : <<include>>

Administrateur --> UC_Stock
UC_Stock ..> UC_Stock_Update : <<include>>
UC_Stock ..> UC_Stock_Alert : <<include>>

Administrateur --> UC_Cmd_Admin
UC_Cmd_Admin ..> UC_Cmd_View : <<include>>
UC_Cmd_Admin ..> UC_Cmd_Validate : <<include>>
UC_Cmd_Admin ..> UC_Cmd_Ship : <<include>>

Administrateur --> UC_User_Admin
UC_User_Admin ..> UC_User_View : <<include>>
UC_User_Admin ..> UC_User_Block : <<include>>

' --- Relations Client ---
Client --> UC_Auth
UC_Auth ..> UC_Auth_Register : <<include>>
UC_Auth ..> UC_Auth_Login : <<include>>

Client --> UC_Browse
UC_Browse ..> UC_Browse_Detail : <<include>>

Client --> UC_Cart
UC_Cart ..> UC_Cart_Add : <<include>>

Client --> UC_Order
UC_Cart ..> UC_Order : <<extend>>

Client --> UC_Pay
UC_Pay ..> UC_Pay_Input : <<include>>
UC_Pay --> Paiement : valide

Client --> UC_Track

@enduml